            img: "img-sample.jpg",
            date: "2022.01.01",
            label: ["カテゴリ","カテゴリ2"],
            title: "お知らせの投稿タイトルがここに入ります。",
            excerpt: "簡単な説明テキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキスト",
            icon: "arrow_forward",
          },
          {
            date: "2022.01.01",
            label: ["カテゴリ","カテゴリ2"],
            title: "リンク無しのテスト",
          },
          undefined
        ])

      +c_pagination().is-align-left

      +c.card-post.is-tag-hidden.u-mbs.is-top.is-lg
        +loop(4)
          +e.block
            +a.c-card-post__image
              +img("img-card-01.jpg")
            +e.content
              +e.sup
                span.c-card-post__label.c-label カテゴリ名
                +e.date 2018.01.01
              +e.title タイトルが入ります。タイトルが入ります。
      +c_pagination()

block aside
  +l-aside-posts()
