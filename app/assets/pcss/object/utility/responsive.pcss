// レスポンシブ用ユーティリティクラス

// スマートフォンだけ隠す
@mixin breakpoint small only {
  .u-hidden-sm {
    display: none !important;
  }
}

// タブレットから隠す
@mixin breakpoint medium down {
  .u-hidden-md {
    display: none !important;
  }
}

// デスクトップだけ隠す
@mixin breakpoint medium up {
  .u-hidden-lg {
    display: none !important;
  }
}


// 表示

.u-visible-sm,
.u-visible-md,
.u-visible-lg {
  display: none !important;
}

// スマートフォンだけ表示する
@mixin breakpoint small only {
  .u-visible-sm {
    display: block !important;
    &.is-inlineblock {
      display: inline-block !important;
    }
  }
}

// タブレットから表示する
@mixin breakpoint medium down {
  .u-visible-md {
    display: block !important;
    &.is-inlineblock {
      display: inline-block !important;
    }
  }
}

// デスクトップだけ表示する
@mixin breakpoint medium up {
  .u-visible-lg {
    display: block !important;
    &.is-inlineblock {
      display: inline-block !important;
    }
  }
}
