.c-modal-link {
  position: relative;
  cursor: pointer;
  @mixin transition;

  &:after {
    content: "search";
    @mixin icon-font;
    position: absolute;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    background: $color-primary;
    color: $color-white;
  }

  @mixin hover {
    opacity: 0.5;
  }
}
