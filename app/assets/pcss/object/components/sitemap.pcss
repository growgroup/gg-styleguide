.c-sitemap {
  &__inner {

  }

  &__list {

  }

  &__item {

    &:not(:last-child) {
      margin-bottom: 20px;
    }

    a {
      text-decoration: none;
      font-size: 20px;
      color: $font-base-color;
      position: relative;
      padding-bottom: 10px;
      border-bottom: 2px solid $border-base-color;
      display: block;

      @mixin breakpoint small only {
        font-size: 16px;
      }


      &.is-outlink {

        &:after {
          color: $color-primary;
          margin-left: 14px;
          vertical-align: middle;
        }
      }
    }

    &.is-parent {
      margin-bottom: 40px;

      @mixin breakpoint small only {
        margin-bottom: 20px;
      }
    }
  }

  &__flex {
    display: flex;
    align-items: flex-start;
  }

  &__sublist {
    display: flex;
    flex-wrap: wrap;
    margin-top: 36px;

    @mixin breakpoint small only {
      margin-top: 18px;
    }

    &.is-three-col {
      width: 75%;

      @mixin breakpoint medium down {
        width: 50%;
      }

      @mixin breakpoint small only {
        width: 100%;
      }

      .c-sitemap__subitem {
        width: 33.3%;

        @mixin breakpoint medium down {
          width: 100%;
        }

        @mixin breakpoint small only {
          width: 50%;
        }
      }
    }

    &.is-one-col {
      width: 25%;

      .c-block-sitemap__subitem {
        width: 100%;
      }
    }
  }


  &__subitem {

    width: 25%;
    margin-bottom: 20px;
    padding-right: 10px;

    @mixin breakpoint medium down {
      width: 50%;
    }

    @mixin breakpoint small only {
      margin-bottom: 10px;
    }

    a {
      font-size: 16px;
      border-bottom: none;
      padding: 0;

      @mixin breakpoint small only {
        font-size: 14px;
      }
    }


    ul {
      margin-top: 20px;


    }

    li {


      a {
        font-size: 13px;
        &:before {
          content: "-";
          display: inline-block;
        }

        @mixin breakpoint small only {
          font-size: 12px;
        }
      }
    }
  }

}
