/*
---
name: ヒーローブロック_枡目型
category: SpecialComponents
---
*/

.c-hero-block-square {
  &__block {
    position: relative;
    @mixin breakpoint small only {
      margin-bottom: 16px;
    }
  }

  &__image {
    position: absolute;
    left: 0;
    top: 0;
    width: 50%;
    height: 100%;
    min-height: 400px;
    overflow: hidden;
    @mixin breakpoint small only {
      position: relative;
      width: 100%;
      min-height: 60vw;
    }

    img {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: auto;
      height: auto;
      min-width: 100%;
      //min-height: 100%;
      max-width: inherit;
      @mixin breakpoint small only {
        width: auto;
        height: 100%;
      }
    }
  }

  &__content {
    width: 50%;
    margin-left: auto;
    padding: 56px 0 56px 64px;
    display: flex;
    min-height: 400px;
    align-items: center;
    @mixin breakpoint small only {
      width: 100%;
      padding: 24px 0;
      min-height: inherit;
      display: block;
    }

    .c-heading {
      @mixin breakpoint small only {
        margin-bottom: 16px;
      }
    }
  }

  &__button {
    margin-top: 32px;
    @mixin breakpoint small only {
      margin-top: 24px;
    }
  }
}

// 偶数番目
.c-hero-block-square__block:nth-child(even),
.c-hero-block-square__block.is-reverse {
  .c-hero-block-square__image {
    left: auto;
    right: 0;
  }

  .c-hero-block-square__content {
    margin-left: 0;
    padding: 56px 64px 56px 0;
  }
}

// 数字付き
.c-hero-block-square.is-number {
  .c-hero-block-square__heading {
    display: flex;
    align-items: center;
    margin-bottom: 8px;

    span {
      @mixin webfont;
      font-size: 60px;
      line-height: sass-div(71, 60)*1;
      letter-spacing: 0;
      color: $color-primary;
      margin-right: 16px;
      @mixin breakpoint small only {
        font-size: 48px;
      }
    }

    .c-heading {
      margin-bottom: 0;
    }
  }

}

//比率変更
.c-hero-block-square.is-zigzag {

  .c-hero-block-square__block {
    margin-bottom: 80px;
  }

  .c-hero-block-square__image {
    width: sass-div(718, 1400)*100%;
    @mixin breakpoint small only {
      width: 100%;
    }
  }

  .c-hero-block-square__content {
    width: sass-div(550, 1140)*100%;
    padding-top: 0;
    padding-bottom: 0;
    display: block;
    @mixin breakpoint small only {
      width: 100%;
    }
  }

  .c-hero-block-square__title {
    margin-top: 0;
    margin-bottom: 24px;
  }

  .c-hero-block-square__question {
    margin-bottom: 24px;
  }

}

