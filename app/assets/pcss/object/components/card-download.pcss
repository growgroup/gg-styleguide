.c-card-download {

  &__head {

    &.c-heading.is-md.is-border-bottom {
      margin-bottom: 40px;

      @mixin breakpoint small only {
        margin-bottom: 24px;
      }
    }
  }

  &__blocks {
    display: flex;
    flex-wrap: wrap;
    margin: 0 -18px;

    @mixin breakpoint small only {
      display: block;
      margin: 0;
    }
  }

  &__block {
    display: block;
    text-decoration: none;
    color: $font-base-color;
    width: calc(50% - 36px);
    background: $color-white;
    padding: 24px 24px 32px;
    margin: 0 18px;

    @mixin breakpoint small only {
      width: 100%;
      padding: 20px 20px 24px;
      margin: 0;
    }

    &:nth-child(n + 3) {
      margin-top: 32px;
    }

    &:not(:first-child) {

      @mixin breakpoint small only {
        margin-top: 24px;
      }
    }

    @mixin hover {
      opacity: 1;

      img {
        transform: scale(1.1);
      }

      .c-button {
        background-color: $color-white;
        color: $color-primary;
      }
    }
  }

  &__image {
    overflow: hidden;
    position: relative;
    background: $color-background;
    aspect-ratio: 504/311;

    img {
      @mixin img-option;
      @mixin transition;
    }

    .is-no {
      width: 100%;
      height: 100%;
      display: grid;
      place-content: center;
      font-size: 17px;
      color: rgba($font-base-color,0.5);

      @mixin breakpoint small only {
        font-size: 14px;
      }
    }
  }

  &__label {
    position: absolute;
    left: 0;
    bottom: 0;
  }

  &__content {
    margin-top: 16px;

    @mixin breakpoint small only {
      margin-top: 12px;
    }
  }

  &__button {
    margin-top: 24px;

    @mixin breakpoint small only {
      margin-top: 16px;
    }

    .c-button {
      max-width: 100%;
      padding-top: 8px;
      padding-bottom: 8px;

      &:before {
        content: none;
      }

      &:after {
        transform: translateY(-50%);
      }
    }
  }


  &.is-three-col {

    .c-card-download__block {
      width: calc(33.3% - 36px);
      margin-top: 0;

      @mixin breakpoint medium down {
        width: calc(50% - 36px);
      }

      @mixin breakpoint small only {
        width: 100%;
      }

      &:nth-child(n + 4) {
        margin-top: 32px;
      }

      &:nth-child(n + 3) {

        @mixin breakpoint medium down {
          margin-top: 32px;
        }
      }

      &:not(:first-child) {

        @mixin breakpoint small only {
          margin-top: 24px;
        }
      }
    }

    .c-card-download__title {
      @mixin line-clamp 3;
    }
  }
}
