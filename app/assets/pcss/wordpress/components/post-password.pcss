.c-post-password {

  &__label {
    display: block;
    margin-bottom: 16px;

    @mixin breakpoint small down {
      margin-bottom: 8px;
    }
  }

  &__content {
    display: flex;
    gap: 24px;

    @mixin breakpoint small down {
      gap: 16px;
    }
  }

  &__input {
    width: 100%;

    input {
      height: 100%;
    }
  }

  &__submit {
    flex-shrink: 0;
  }
}
